<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dış mor glow halkası: tuşun etrafına taşan hafif ışıma hissi -->
    <item android:top="-4dp" android:bottom="-4dp" android:left="-4dp" android:right="-4dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#556B4FE0" />
        </shape>
    </item>
    <!-- Ana mor gövde -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:angle="90"
                android:startColor="#B79CFF"
                android:centerColor="#8B5FE8"
                android:endColor="#6B3FD4"
                android:type="linear" />
            <stroke android:width="2dp" android:color="#D6C4FF" />
        </shape>
    </item>
</layer-list>
