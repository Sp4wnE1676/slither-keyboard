<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:angle="90"
                android:startColor="#D8DADF"
                android:centerColor="#AEB2BB"
                android:endColor="#8A8E99"
                android:type="linear" />
        </shape>
    </item>
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:angle="90"
                android:startColor="#CDD0D7"
                android:centerColor="#9AA0AB"
                android:endColor="#6E7280"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
